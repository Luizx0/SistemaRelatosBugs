@model SistemaRelatosBugs.Web.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Relatos de Bugs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-container {
            width: 100%;
            max-width: 400px;
        }
        .login-box {
            background-color: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        .login-box h2 {
            text-align: center;
            margin-bottom: 10px;
            color: #2c3e50;
            font-weight: bold;
        }
        .login-subtitle {
            text-align: center;
            color: #7f8c8d;
            margin-bottom: 30px;
            font-size: 0.9rem;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-control {
            border: 1px solid #e0e0e0;
            padding: 12px 15px;
            border-radius: 5px;
            font-size: 0.95rem;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 12px 20px;
            width: 100%;
            border-radius: 5px;
            font-weight: 600;
            margin-top: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-login:hover {
            background: linear-gradient(135deg, #5568d3 0%, #6a3fa1 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        .error-message {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 10px;
            padding: 10px;
            background-color: #fadbd8;
            border-radius: 5px;
            border-left: 4px solid #e74c3c;
        }
        label {
            color: #2c3e50;
            font-weight: 500;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <h2>🐛 Sistema de Relatos</h2>
            <p class="login-subtitle">Faça login para continuar</p>

            <form asp-action="Login" method="post">
                <div class="form-group">
                    <label for="Login">Email, CPF ou Usuário</label>
                    <input class="form-control" id="Login" asp-for="Login" placeholder="Digite seu login" />
                </div>
                <div class="form-group">
                    <label for="Senha">Senha</label>
                    <input class="form-control" id="Senha" asp-for="Senha" type="password" placeholder="Digite sua senha" />
                </div>
                <button type="submit" class="btn btn-login">Entrar</button>
            </form>

            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="error-message">
                    <strong>Erro:</strong> @error.ErrorMessage
                </div>
            }

            <hr style="margin-top: 30px; margin-bottom: 20px;" />
            <p style="text-align: center; color: #7f8c8d; font-size: 0.85rem;">
                <strong>Dados de teste:</strong><br />
                Gestor: admin / 123<br />
                Relator: joao / 123
            </p>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
